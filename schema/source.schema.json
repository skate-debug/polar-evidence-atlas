{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/polar-kg/schema/source.schema.json",
  "title": "Curated polar literature source",
  "type": "object",
  "required": [
    "id", "citation_key", "doi", "title", "year", "domains", "poles",
    "study_type", "study_profile", "key_findings", "limitations",
    "cite_for", "do_not_overcite", "curation"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^src:"},
    "citation_key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]+$"},
    "doi": {"type": "string", "pattern": "^10\\."},
    "title": {"type": "string", "minLength": 8},
    "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
    "domains": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "poles": {"type": "array", "items": {"enum": ["Arctic", "Antarctic", "Bipolar", "Global"]}},
    "collection": {"enum": ["polar", "scs-cold-seeps", "global-cold-seeps"]},
    "regions": {"type": "array", "items": {"type": "string"}},
    "compartments": {"type": "array", "items": {"type": "string"}},
    "topics": {"type": "array", "items": {"type": "string"}},
    "sites": {"type": "array", "items": {"type": "string"}},
    "study_type": {"type": "string"},
    "study_profile": {
      "type": "object",
      "required": ["spatial_scope", "temporal_scope", "habitats", "methods", "sample_design", "measured_or_derived"],
      "properties": {
        "spatial_scope": {"type": "string"},
        "temporal_scope": {"type": "string"},
        "habitats": {"type": "array", "items": {"type": "string"}},
        "methods": {"type": "array", "items": {"type": "string"}},
        "sample_design": {"type": "string"},
        "measured_or_derived": {"type": "array", "items": {"type": "string"}},
        "focal_taxa": {"type": "array", "items": {"type": "string"}},
        "focal_processes": {"type": "array", "items": {"type": "string"}},
        "environmental_drivers": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "key_findings": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cite_for": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "do_not_overcite": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "data_accessions": {"type": "array", "items": {"type": "string"}},
    "curation": {
      "type": "object",
      "required": ["status", "basis", "last_verified"],
      "properties": {
        "status": {"const": "curated"},
        "basis": {"type": "string"},
        "last_verified": {"type": "string", "format": "date"}
      }
    }
  },
  "additionalProperties": true
}

