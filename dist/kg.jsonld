  "@graph": [
    {
      "@id": "pole:arctic",
      "@type": "pkg:Pole",
      "rdfs:label": "Arctic",
      "schema:description": "Ocean-centred northern polar region, here including the Arctic Ocean, its marginal seas, islands, terrestrial catchments, permafrost, and gateways."
    },
    {
      "@id": "pole:antarctic",
      "@type": "pkg:Pole",
      "rdfs:label": "Antarctic",
      "schema:description": "Continent-centred southern polar region, including Antarctica, its ice sheet and shelves, surrounding islands, and the Southern Ocean."
    },
    {
      "@id": "pole:bipolar",
      "@type": "pkg:Pole",
      "rdfs:label": "Bipolar",
      "schema:description": "A pattern, comparison, or distribution involving both polar regions."
    },
    {
      "@id": "region:arctic-ocean",
      "@type": "pkg:Region",
      "rdfs:label": "Arctic Ocean",
      "schema:description": "Small, strongly stratified ocean surrounded by continents and connected to the Pacific and Atlantic through restricted gateways.",
      "skos:broader": {
        "@id": "pole:arctic"
      }
    },
    {
      "@id": "region:southern-ocean",
      "@type": "pkg:Region",
      "rdfs:label": "Southern Ocean",
      "schema:description": "Circumpolar ocean surrounding Antarctica and linking the Atlantic, Indian, and Pacific basins.",
